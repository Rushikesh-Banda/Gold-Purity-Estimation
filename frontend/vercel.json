{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://gold-purity-estimation.onrender.com/api/:path*"
    },
    {
      "source": "/graphs/:path*",
      "destination": "https://gold-purity-estimation.onrender.com/graphs/:path*"
    },
    {
      "source": "/reports/:path*",
      "destination": "https://gold-purity-estimation.onrender.com/reports/:path*"
    }
  ]
}
